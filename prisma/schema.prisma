// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LocationType {
  SHOP      @map("shop")
  WAREHOUSE @map("warehouse")

  @@map("location_type")
}

enum MovementType {
  INCOMING @map("in")
  OUTGOING @map("out")
  TRANSFER

  @@map("movement_type")
}

enum DiscountType {
  PERCENT
  FIXED

  @@map("discount_type")
}

enum PaymentMethod {
  CASH
  WHISH

  @@map("payment_method")
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  password       String
  createdAt      DateTime        @default(now()) @map("created_at")
  stockMovements StockMovement[]
  sales          Sale[]
  payments       Payment[]

  @@map("users")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  productCode    String          @unique @map("product_code")
  categoryId     Int             @map("category_id")
  price          Decimal
  unit           String
  category       Category        @relation(fields: [categoryId], references: [id])
  stocks         Stock[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@map("products")
}

model Location {
  id                    Int             @id @default(autoincrement())
  name                  String          @unique
  type                  LocationType
  stocks                Stock[]
  movementsFrom         StockMovement[] @relation("MovementFromLocation")
  movementsTo           StockMovement[] @relation("MovementToLocation")
  saleItems             SaleItem[]

  @@map("locations")
}

model Stock {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  locationId Int      @map("location_id")
  quantity   Decimal  @default(0)
  product    Product  @relation(fields: [productId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@map("stock")
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  phone          String?
  email          String          @unique
  createdAt      DateTime        @default(now()) @map("created_at")
  stockMovements StockMovement[]

  @@map("suppliers")
}

model StockMovement {
  id             Int          @id @default(autoincrement())
  productId      Int          @map("product_id")
  type           MovementType
  quantity       Decimal
  fromLocationId Int?         @map("from_location_id")
  toLocationId   Int?         @map("to_location_id")
  supplierId     Int?         @map("supplier_id")
  movementDate   DateTime     @default(now()) @map("movement_date")
  userId         Int          @map("user_id")
  product        Product      @relation(fields: [productId], references: [id])
  fromLocation   Location?    @relation("MovementFromLocation", fields: [fromLocationId], references: [id])
  toLocation     Location?    @relation("MovementToLocation", fields: [toLocationId], references: [id])
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([movementDate])
  @@map("stock_movements")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  balance   Decimal  @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  sales     Sale[]
  payments  Payment[]

  @@map("customers")
}

model Sale {
  id           Int          @id @default(autoincrement())
  customerId   Int?         @map("customer_id")
  userId       Int          @map("user_id")
  saleDate     DateTime     @default(now()) @map("sale_date")
  subtotal     Decimal
  discountType DiscountType? @map("discount_type")
  discountValue Decimal?    @default(0) @map("discount_value")
  total        Decimal
  paidAmount   Decimal      @default(0) @map("paid_amount")
  remaining    Decimal      @default(0)
  customer     Customer?    @relation(fields: [customerId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  items        SaleItem[]
  payments     Payment[]

  @@index([saleDate])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id         Int      @id @default(autoincrement())
  saleId     Int      @map("sale_id")
  productId  Int      @map("product_id")
  locationId Int      @map("location_id")
  quantity   Decimal
  unitPrice  Decimal  @map("unit_price")
  lineTotal  Decimal  @map("line_total")
  sale       Sale     @relation(fields: [saleId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])

  @@map("sale_items")
}

model Payment {
  id           Int           @id @default(autoincrement())
  customerId   Int           @map("customer_id")
  saleId       Int?          @map("sale_id")
  amount       Decimal
  paymentDate  DateTime      @default(now()) @map("payment_date")
  method       PaymentMethod @default(CASH)
  userId       Int           @map("user_id")
  customer     Customer      @relation(fields: [customerId], references: [id])
  sale         Sale?         @relation(fields: [saleId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@map("payments")
}
